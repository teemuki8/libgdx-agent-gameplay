{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teemuki8.github.io/libgdx-agent-gameplay/schema/gameplay-prefabs.schema.json",
  "title": "libGDX Agent Gameplay Prefabs V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "prefabs"],
  "properties": {
    "schemaVersion": {"const": "gameplay-prefabs/1"},
    "prefabs": {
      "type": "array",
      "maxItems": 1024,
      "items": {"$ref": "#/$defs/prefab"}
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "number": {"type": "number"},
    "integer": {"type": "integer"},
    "vec2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [{"$ref": "#/$defs/number"}, {"$ref": "#/$defs/number"}]
    },
    "rgba": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1}
      ]
    },
    "prefab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "components"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "components": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/component"}
        }
      }
    },
    "component": {
      "oneOf": [
        {"$ref": "#/$defs/transform"},
        {"$ref": "#/$defs/movement"},
        {"$ref": "#/$defs/health"},
        {"$ref": "#/$defs/faction"},
        {"$ref": "#/$defs/lifetime"},
        {"$ref": "#/$defs/collider"},
        {"$ref": "#/$defs/sprite"},
        {"$ref": "#/$defs/animation"},
        {"$ref": "#/$defs/render"}
      ]
    },
    "transform": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "size"],
      "properties": {
        "type": {"const": "transform"}, "position": {"$ref": "#/$defs/vec2"},
        "rotationRadians": {"$ref": "#/$defs/number"}, "size": {"$ref": "#/$defs/vec2"},
        "pivot": {"$ref": "#/$defs/vec2"}
      }
    },
    "movement": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "maxSpeed"],
      "properties": {
        "type": {"const": "movement"}, "velocity": {"$ref": "#/$defs/vec2"},
        "maxSpeed": {"$ref": "#/$defs/number"}
      }
    },
    "health": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "max"],
      "properties": {
        "type": {"const": "health"}, "current": {"$ref": "#/$defs/integer"},
        "max": {"$ref": "#/$defs/integer"}
      }
    },
    "faction": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {"type": {"const": "faction"}, "value": {"$ref": "#/$defs/id"}}
    },
    "lifetime": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "remainingTicks"],
      "properties": {
        "type": {"const": "lifetime"}, "remainingTicks": {"$ref": "#/$defs/integer"}
      }
    },
    "collider": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "shape", "size"],
      "properties": {
        "type": {"const": "collider"}, "shape": {"enum": ["box", "circle"]},
        "size": {"$ref": "#/$defs/vec2"}, "offset": {"$ref": "#/$defs/vec2"},
        "sensor": {"type": "boolean"},
        "categoryBits": {"type": "integer", "minimum": 0, "maximum": 65535},
        "maskBits": {"type": "integer", "minimum": 0, "maximum": 65535}
      }
    },
    "sprite": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "asset"],
      "properties": {
        "type": {"const": "sprite"}, "asset": {"$ref": "#/$defs/id"},
        "region": {"$ref": "#/$defs/id"}, "visualSize": {"$ref": "#/$defs/vec2"},
        "origin": {"$ref": "#/$defs/vec2"}
      }
    },
    "clip": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "frames", "frameDurationTicks"],
      "properties": {
        "name": {"$ref": "#/$defs/id"},
        "frames": {
          "type": "array", "minItems": 1, "maxItems": 256,
          "items": {"$ref": "#/$defs/id"}
        },
        "frameDurationTicks": {"type": "integer", "minimum": 1},
        "loop": {"type": "boolean"}
      }
    },
    "animation": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "clips", "currentClip"],
      "properties": {
        "type": {"const": "animation"},
        "clips": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/clip"}},
        "currentClip": {"$ref": "#/$defs/id"},
        "elapsedTicks": {"type": "integer", "minimum": 0},
        "frameIndex": {"type": "integer", "minimum": 0}
      }
    },
    "render": {
      "type": "object", "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"const": "render"}, "layer": {"$ref": "#/$defs/id"},
        "order": {"type": "integer"}, "tint": {"$ref": "#/$defs/rgba"},
        "visible": {"type": "boolean"}
      }
    }
  }
}
